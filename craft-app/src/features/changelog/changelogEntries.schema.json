{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Craft UI changelog",
  "description": "Components added to the gallery, one entry per commit, newest first. Generated by `npm run changelog`.",
  "type": "object",
  "required": ["generatedAt", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "generatedAt": {
      "type": "string",
      "format": "date",
      "description": "Day the file was generated."
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "commit", "summary", "components"],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "description": "Commit day, YYYY-MM-DD."
          },
          "commit": {
            "type": "string",
            "description": "Short hash of the commit that added the components."
          },
          "summary": {
            "type": "string",
            "description": "The commit subject, written as a release note."
          },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["slug", "title", "description", "categories"],
              "additionalProperties": false,
              "properties": {
                "slug": {
                  "type": "string",
                  "description": "Route under /examples/ and the preview image name."
                },
                "title": { "type": "string" },
                "description": { "type": "string" },
                "categories": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
